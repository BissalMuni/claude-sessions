# claude-sessions 환경설정 예시.
# 이 파일을 복사해 .env 로 만들고 실제 값을 채운다 (.env 는 git 에 올라가지 않음).
#   cp .env.example .env   (PowerShell: Copy-Item .env.example .env)

# ── 비번별 폴더 샌드박스(다계정) ──────────────────────────────────────────
# 계정마다 한 줄. 형식:  SCREEN_ACCOUNT_<번호>=비번|접근폴더|이름
#   · 1번부터 연속으로 읽는다(빈 번호를 만나면 멈춘다).
#   · 접근폴더(root)를 비우면 전체 접근(무제한).
#   · 이름(label)은 선택. 비번에는 파이프(|) 문자를 쓰지 말 것.
# 예(실제 값으로 바꿔 쓰세요):
# SCREEN_ACCOUNT_1=<비번>|<접근폴더>|<이름>
# SCREEN_ACCOUNT_2=<비번2>|<접근폴더2>|<이름2>
# SCREEN_ACCOUNT_3=<비번3>||<이름3>

# ── 다계정을 안 쓸 때: 단일 접속 토큰 ────────────────────────────────────
# 위 SCREEN_ACCOUNT_* 이 하나도 없으면 이 토큰 하나로 접속(무제한).
# SCREEN_TOKEN=changeme

# ── 기타(선택) ──────────────────────────────────────────────────────────
# PORT=8787
# HOST=0.0.0.0
# SCREEN_DANGER=0            # 안전 모드로 시작(기본은 위험 모드 ON)
# SCREEN_START_DIR=C:\proj   # 폴더 피커 시작 위치(무제한 계정)
